{
  "manifest_version": 3,
  "name": "New",
  "version": "0.1.0",
  "description": "Capture selected elements/text and send JSON to a local endpoint.",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-selection-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Toggle selection mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": [
        "constants.js",
        "utils.js",
        "metadata.js",
        "ui.js",
        "selection.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
