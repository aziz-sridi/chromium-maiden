{
  "manifest_version": 3,
  "name": "Chromium Maiden",
  "version": "1.1.0",
  "minimum_chrome_version": "102",
  "description": "A calm browser companion that filters harmful speech before you read or send it.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "https://www.instagram.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*",
        "https://www.instagram.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "utils/apiClient.js",
        "utils/domDetection.js",
        "contentScript.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "mascots/default_maid/*.png"
      ],
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*",
        "https://www.instagram.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*"
      ]
    }
  ]
}
